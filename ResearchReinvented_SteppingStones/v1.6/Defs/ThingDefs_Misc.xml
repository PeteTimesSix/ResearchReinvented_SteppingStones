<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="CraftingSpot">
    <defName>RR_CraftingTable</defName>
    <label>crafting table</label>
    <description>A place for crafting simple items like knives or bows. Production here is slow because of the lack of tools, but having a solid working surface still helps.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>RRSS/Things/TableCrafting</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4,3)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <minifiedDef>MinifiedThing</minifiedDef>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <useHitPoints>true</useHitPoints>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>0.4</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <interactionCellIcon>DiningChair</interactionCellIcon>
    <noRightClickDraftAttack>true</noRightClickDraftAttack>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <uiOrder>2300</uiOrder>
    <uiIconScale>0.8</uiIconScale>
    <statBases>
      <MaxHitPoints>75</MaxHitPoints>
      <WorkToBuild>750</WorkToBuild>
      <Mass>5</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>0.5</Beauty>
      <WorkTableWorkSpeedFactor>0.65</WorkTableWorkSpeedFactor>
    </statBases>
    <scatterableOnMapGen>true</scatterableOnMapGen>
    <replaceTags>
      <li>Table</li>
    </replaceTags>
    <size>(2,1)</size>
    <costStuffCount>28</costStuffCount>
    <designationCategory>Production</designationCategory>
    <uiOrder>2000</uiOrder>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <paintable>true</paintable>
      <ai_chillDestination>false</ai_chillDestination>
      <buildingTags>
        <li>Production</li>
      </buildingTags>
      <workTableRoomRole>Workshop</workTableRoomRole>
    </building>
    <comps></comps>
    <designationHotKey>Misc1</designationHotKey>
    <placeWorkers></placeWorkers>
    <researchPrerequisites>
      <li>RR_BasicFurniture</li>
    </researchPrerequisites>
  </ThingDef>


  <ThingDef ParentName="BuildingBase">
    <defName>RR_VoltaicPile</defName>
    <label>voltaic pile</label>
    <description>A crude but effective means of generating small amounts of electricity. Nonrechargeable.\n\nWhile the metals and electrolytes used vary between designs, all voltaic piles function by harnessing chemically-induced electrical potential between two electrodes.</description>
    <thingClass>Building</thingClass>
    <size>(1,1)</size>
    <graphicData>
      <texPath>RRSS/Things/voltaic_pile</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <pathCost>30</pathCost>
    <rotatable>false</rotatable>
    <blockWind>false</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <WorkToBuild>1000</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Beauty>-10</Beauty>
    </statBases>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
    <tickerType>Normal</tickerType>
    <canOverlapZones>true</canOverlapZones>
    <building>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
    </building>
    <costList>
      <Steel>40</Steel>
      <RawBerries>40</RawBerries>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerPlant</compClass>
        <basePowerConsumption>-200</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>20.0</fuelConsumptionRate>
        <fuelCapacity>100.0</fuelCapacity>
        <fuelFilter>
          <thingDefs>
          </thingDefs>
        </fuelFilter>
        <initialFuelPercent>1</initialFuelPercent>
        <showAllowAutoRefuelToggle>false</showAllowAutoRefuelToggle>
      </li>
      <li Class="CompProperties_Styleable" />
    </comps>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Power</designationCategory>
    <uiOrder>2100</uiOrder>
    <constructEffect>ConstructMetal</constructEffect>
    <researchPrerequisites>
      <li>RR_ElectricityBasics</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
  </ThingDef>

  <ThingDef ParentName="BaseMeleeWeapon_Blunt">
    <defName>RR_Weapon_Torch</defName>
    <label>torch</label>
    <description>Wood from trees or other fibrous plants, wrapped in cloth and soaked in a flammable substance. Can be used as a weapon in a pinch.</description>
    <graphicData>
      <texPath>Things/Building/Misc/TorchLamp</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <uiIconScale>1.1</uiIconScale>
    <techLevel>Neolithic</techLevel>
    <weaponTags>
      <li>NeolithicMeleeBasic</li>
    </weaponTags>
    <weaponClasses>
      <li>Neolithic</li>
    </weaponClasses>
    <statBases>
      <WorkToMake>1200</WorkToMake>
      <Mass>1</Mass>
    </statBases>
    <equippedAngleOffset>-10</equippedAngleOffset>
    <costList>
      <WoodLog>1</WoodLog>
      <Cloth>10</Cloth>
      <Chemfuel>5</Chemfuel>
    </costList>
    <recipeMaker>
      <recipeUsers>
        <li>CraftingSpot</li>
      </recipeUsers>
    <researchPrerequisites>
      <li>RR_IncendiaryWeapons</li>
    </researchPrerequisites>
      <displayPriority>300</displayPriority>
    </recipeMaker>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>head</label>
        <labelUsedInLogging>false</labelUsedInLogging>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
        <extraMeleeDamages>
          <li>
            <def>Flame</def>
            <amount>2</amount>
            <chance>0.25</chance>
          </li>
        </extraMeleeDamages>
      </li>
    </tools>
		<tickerType>Normal</tickerType>
    <comps>
      <li Class="PeteTimesSix.ResearchReinvented_SteppingStones.Comps.CompProperties_CarriedGlower">
        <glowerProps>
          <glowColor>(255,136,83,0)</glowColor>
          <glowRadius>4.49</glowRadius>
          <overlightRadius>1.49</overlightRadius>
        </glowerProps>
      </li>
    </comps>
  </ThingDef>

</Defs>
